# Cloudflare Pages response headers.
#
# SYNTAX WARNING: comments are only recognised at the start of a line. An
# indented "#" inside a rule block is parsed as a malformed header and takes
# neighbouring entries down with it — which is exactly how the first version of
# this file silently shipped without a CSP. Keep every comment at column 0, and
# verify with `curl -sI` after deploying rather than assuming.
#
# https://developers.cloudflare.com/pages/configuration/headers/
#
#
# Content-Security-Policy, directive by directive:
#
#   default-src 'self'        everything unlisted may only come from this origin
#   script-src 'self'         no inline scripts and no eval; the theme bootstrap
#                             lives in /theme-init.js precisely so this can stay
#                             strict
#   style-src  'unsafe-inline' required: React sets inline styles, and Shiki and
#                             Mermaid emit styled markup. Style injection cannot
#                             exfiltrate on its own, and connect-src closes the
#                             channel it would need
#   img-src    https:         deliberately permissive. Markdown routinely links
#                             images by absolute URL and refusing them would
#                             break ordinary documents. The tradeoff: opening
#                             such a document reveals your IP to that host. It
#                             cannot leak file contents
#   connect-src 'self'        THE important one. fetch, XHR, WebSocket and
#                             sendBeacon cannot reach another origin, so there
#                             is no route off the machine for document text or
#                             anything read through a directory handle
#   frame-src/object-src      no embedding of anything
#   frame-ancestors 'none'    RendMD cannot itself be framed, which rules out
#                             clickjacking a permission prompt
#   form-action 'none'        a planted form cannot POST anywhere
#   base-uri 'self'           a <base> tag cannot repoint relative URLs
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# The service worker and the pre-paint theme script must not be cached, or
# clients pin themselves to an old build and stop seeing updates.
/sw.js
  Cache-Control: no-cache

/theme-init.js
  Cache-Control: no-cache
